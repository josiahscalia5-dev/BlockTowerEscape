<resources>
    <!-- Android 12+ system splash: plain sky colour so it flows straight into the game's own splash screen. -->
    <style name="Theme.BlockTowerEscape" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowSplashScreenBackground">@color/sky</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
